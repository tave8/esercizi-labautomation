        <Address>%SW30</Address>
        <Index>30</Index>
        <Symbol>SW_LASTSCAN1</Symbol>
        <Comment>Mostra il tempo di esecuzione dell'ultimo ciclo di scansione controller (in ms). Se il tempo di scansione è 2.250 ms, %SW30 = 2 e %SW70 = 250</Comment>
      </MemoryWord>
      <MemoryWord>
        <Address>%SW31</Address>
        <Index>31</Index>
