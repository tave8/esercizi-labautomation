        <Comment>Backup/ripristino dei valori di memoria su/da memoria non volatile (valore predefinito 0) o su/da scheda SD (1)</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S91</Address>
        <Index>91</Index>
        <Symbol>SB_MWERASE</Symbol>
        <Comment>Impostare questo bit a 1 per cancellare tutti i valori di memoria nella memoria non volatile</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S92</Address>
        <Index>92</Index>
        <Symbol>SB_MWSAVED</Symbol>
