      </MemoryBit>
      <MemoryBit>
        <Address>%S105</Address>
        <Index>105</Index>
        <Symbol>SB_MODINIT</Symbol>
        <Comment>Impostato a 1, questo bit consente di inizializzare il modem, vedere anche %SW167</Comment>
      </MemoryBit>
