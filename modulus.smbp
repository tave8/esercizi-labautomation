      </MemoryBit>
      <MemoryBit>
        <Address>%S14</Address>
        <Index>14</Index>
        <Symbol>SB_IOFORCED</Symbol>
        <Comment>Questo bit indica che almeno un ingresso o un'uscita è forzato</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S15</Address>
        <Index>15</Index>
        <Symbol>SB_INFORCED</Symbol>
        <Comment>Questo bit indica che almeno un ingresso è forzato</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S16</Address>
        <Index>16</Index>
        <Symbol>SB_OUTFORCED</Symbol>
        <Comment>Questo bit indica che almeno un'uscita è forzata</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S17</Address>
        <Index>17</Index>
        <Symbol>SB_LASTBIT</Symbol>
        <Comment>Indica il valore dell'ultimo bit espulso</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S18</Address>
        <Index>18</Index>
        <Symbol>SB_OPERROR</Symbol>
        <Comment>Indica un overflow quando si esegue un'operazione a 16 bit</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S19</Address>
        <Index>19</Index>
        <Symbol>SB_OVERRUN</Symbol>
        <Comment>Indica un tempo di scansione maggiore del periodo definito dall'utente</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S20</Address>
        <Index>20</Index>
        <Symbol>SB_INDERROR</Symbol>
        <Comment>Questo bit indica un overflow di indice dell'indirizzo oggetto indicizzato quando si esegue un'operazione a 16 bit</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S21</Address>
        <Index>21</Index>
        <Symbol>SB_INITGRAFCET</Symbol>
        <Comment>Allo stato 1, questo bit provoca l'inizializzazione GRAFCET. Vengono disabilitati i passi attivi e vengono attivati i passi iniziali</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S22</Address>
        <Index>22</Index>
        <Symbol>SB_RESETGRAFCET</Symbol>
        <Comment>Allo stato 1, questo bit causa la disattivazione dei passi attivi dell'intero GRAFCET</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S23</Address>
        <Index>23</Index>
        <Symbol>SB_FREEZEGRAFCET</Symbol>
        <Comment>Impostato a 1, questo bit convalida il preposizionamento del GRAFCET. Il mantenimento di questo bit a 1 determina il blocco del GRAFCET (blocco del grafico)</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S28</Address>
        <Index>28</Index>
        <Symbol>SB_STRERROR</Symbol>
        <Comment>Impostato a 1, indica che è presente un overflow in un oggetto di memoria quando si gestiscono le stringhe</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S32</Address>
        <Index>32</Index>
        <Symbol>SB_DEVCIPRESET</Symbol>
        <Comment>Impostato a 1, consente il reset del dispositivo mediante l'oggetto identità CIP nel protocollo Ethernet/IP</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S33</Address>
        <Index>33</Index>
        <Symbol>SB_CONFETH</Symbol>
        <Comment>Impostato a 1 (se non è in uso alcuna post configurazione), questo bit consente di impostare la nuova configurazione Ethernet tramite %SW33 - %SW38</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S34</Address>
        <Index>34</Index>
        <Symbol>SB_AUTOETH</Symbol>
        <Comment>Impostato a 1, questo bit consente di forzare alcune configurazioni specifiche Ethernet impostate in %S35 e %S36</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S35</Address>
        <Index>35</Index>
        <Symbol>SB_DUPLEXMODE</Symbol>
        <Comment>Questo bit indica la modalità Duplex Ethernet. Impostato a 0 se Half Duplex, impostato a 1 se Full Duplex</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S36</Address>
        <Index>36</Index>
        <Symbol>SB_SPEEDETH</Symbol>
        <Comment>Questo bit indica la velocità Ethernet. Impostato a 0 se 10 Mbps, impostato a 1 se 100 Mbps</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S38</Address>
        <Index>38</Index>
        <Symbol>SB_ALLOWEVENT</Symbol>
        <Comment>Questo bit indica se gli eventi sono posizionati nella coda eventi appena vengono rilevati</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S39</Address>
        <Index>39</Index>
        <Symbol>SB_LOSTEVENT</Symbol>
        <Comment>Questo bit indica se è presente una saturazione di coda eventi</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S49</Address>
        <Index>49</Index>
        <Symbol>SB_REARMOUTPUTS</Symbol>
        <Comment>Impostato a 1, è attivato il riarmo automatico delle uscite a seguito di un cortocircuito</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S50</Address>
        <Index>50</Index>
        <Symbol>SB_RTCUPDATE</Symbol>
        <Comment>Impostato a 1, questo bit consente di aggiornare data e ora</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S51</Address>
        <Index>51</Index>
        <Symbol>SB_RTCSTATUS</Symbol>
        <Comment>Impostato a 1 la data e l'ora devono essere inizializzate dall'utente</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S52</Address>
        <Index>52</Index>
        <Symbol>SB_RTCERROR</Symbol>
        <Comment>Allo stato 1, la data e l'ora devono essere inizializzate</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S59</Address>
        <Index>59</Index>
        <Symbol>SB_DATEUPDATE</Symbol>
        <Comment>Impostato a 1, la data e l'ora vengono incrementate o decrementate in base ai fronti di salita sui bit di controllo impostati in %SW59</Comment>
      </MemoryBit>
      <MemoryBit>
        <Address>%S66</Address>
        <Index>66</Index>
        <Symbol>SB_BATLED_DIS</Symbol>
        <Comment>Disabilita il LED della batteria quando è impostato su 1</Comment>
      </MemoryBit>
